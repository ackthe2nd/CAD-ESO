# Resgrid API Configuration
RESGRID_USER=EMSadmin
RESGRID_PASS=a1b2c3D*

# SFTP Configuration for ESO
SFTP_HOST=sftp.esosuite.net
SFTP_PORT=22
SFTP_USERNAME=CAD_12345
SFTP_PASSWORD=<your-sftp-password>
SFTP_REMOTE_PATH=/incoming

# Alternative variable names (for backward-compatibility)
SFTP_USER=CAD_12345
SFTP_PASS=<your-sftp-password>
SFTP_DIR=/incoming

# How often to poll Resgrid for active calls (in milliseconds)
POLL_MS=60000

# Google Sheets logging setup - choose one of the three methods:

# Option 1 (RECOMMENDED): Use Replit Secrets for the most secure approach
# Add the following in the Replit "Secrets" tab (not here in .env):
# 1. Add secret GOOGLE_SERVICE_ACCOUNT_JSON with the entire service account JSON content
# 2. Add secret LOG_SHEET_ID with your Google Sheet ID
# See SETTING_UP_GOOGLE_SHEETS_SECRET.md for details

# Option 2: Use a key file (good for local development)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account-key.json

# Option 3: Base64 encoded JSON (alternative for deployments without Secrets)
# To create: cat your-key-file.json | base64 -w 0
# Make sure there are no line breaks in the encoded string
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-service-account-json>

# The ID of your Google Sheet (required)
# This is the long string in the URL: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
LOG_SHEET_ID=your-google-sheet-id