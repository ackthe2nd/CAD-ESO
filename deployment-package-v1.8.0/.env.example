# Resgrid-ESO Bridge Environment Configuration v1.8.0
# Copy this file to .env and fill in your actual values

# Resgrid API Credentials (Required)
RESGRID_USER=your_resgrid_username
RESGRID_PASS=your_resgrid_password

# Google Sheets Integration (Required)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project","private_key_id":"..."}
LOG_SHEET_ID=your_google_sheet_id

# ESO SFTP Upload Configuration (Optional - for XML file uploads)
SFTP_HOST=sftp.esosuite.net
SFTP_USER=your_eso_username
SFTP_PASS=your_eso_password
SFTP_DIR=/your_upload_directory

# System Configuration (Optional)
NODE_ENV=production
PORT=8081